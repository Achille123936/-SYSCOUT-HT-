{
  "expo": {
    "name": "SYSCOUT-HT",
    "slug": "syscout-ht",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0b1f4d",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ht.ayitidatafoot.syscout",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SYSCOUT-HT utilise la position du téléphone pour mesurer la distance, les sprints et la vitesse du joueur qui le porte."
        }
      ]
    ]
  }
}